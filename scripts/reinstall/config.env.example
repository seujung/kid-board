# Copy to config.env and edit. config.env is git-ignored.
PROJECT_DIR="$HOME/repo/kid-board"
# Find the ID with: xcrun devicectl list devices
DEVICE_ID="00000000-0000-0000-0000-000000000000"
# Must match the bundle ID in Config/Local.xcconfig
BUNDLE_ID="com.example.kidboard"
# Optional. Defaults shown.
#STATE_DIR="$HOME/Library/Application Support/KidBoardReinstall"
#MIN_DAYS=5
# Uncomment if xcode-select points to Command Line Tools.
#DEVELOPER_DIR="/Applications/Xcode.app/Contents/Developer"
