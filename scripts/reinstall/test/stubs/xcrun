#!/bin/zsh
# Test stub: records its arguments to $STUB_LOG. Fails when STUB_FAIL=xcrun.
# Sleeps 30 s when STUB_SLEEP=xcrun (for timeout tests).
print -r -- "xcrun $*" >> "${STUB_LOG:?STUB_LOG not set}"
[[ "${STUB_SLEEP:-}" == "xcrun" ]] && sleep 30
[[ "${STUB_FAIL:-}" == "xcrun" ]] && exit 1
exit 0
