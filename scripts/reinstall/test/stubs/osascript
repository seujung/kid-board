#!/bin/zsh
# Test stub: records its arguments to $STUB_LOG. Fails when STUB_FAIL=osascript.
# Sleeps 30 s when STUB_SLEEP=osascript (for timeout tests).
print -r -- "osascript $*" >> "${STUB_LOG:?STUB_LOG not set}"
[[ "${STUB_SLEEP:-}" == "osascript" ]] && sleep 30
[[ "${STUB_FAIL:-}" == "osascript" ]] && exit 1
exit 0
